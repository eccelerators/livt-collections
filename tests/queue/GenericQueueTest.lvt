namespace Livt.Collections.Tests

using Livt.Collections

/**
 * Checks serialized transactions and unambiguous empty results.
 */
@Test
component GenericQueueTest
{
	// Shared fixture instances, signals, and observation state.
	queue: Livt.Collections.Queue<byte, 3>

	/**
	 * Creates a non-power-of-two queue.
	 */
	new()
	{
		queue = new Livt.Collections.Queue<byte, 3>()
	}

	/**
	 * Verifies rejection, FIFO ordering and repeated wraparound.
	 */
	@Test
	fn TestTransactions()
	{
		queue.Clear()
		var value: byte = 0xFF
		assert queue.TryDequeue(value) == false
		assert value == 0x00

		for (var round = 0; round < 3; round++) {
			assert queue.TryEnqueue(0x11) == true
			assert queue.TryEnqueue(0x22) == true
			assert queue.TryEnqueue(0x33) == true
			assert queue.GetCount() == 3
			assert queue.GetSpace() == 0
			assert queue.TryEnqueue(0xFF) == false
			assert queue.TryDequeue(value) == true
			assert value == 0x11
			assert queue.TryDequeue(value) == true
			assert value == 0x22
			assert queue.TryDequeue(value) == true
			assert value == 0x33
			assert queue.GetCount() == 0
		}
	}
}
