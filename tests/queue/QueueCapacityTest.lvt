namespace Livt.Collections.Tests

using Livt.Collections

/**
 * Verifies storage specialization at both boundary capacities and multiple types.
 */
@Test
component QueueCapacityTest
{
	// Shared fixture instances, signals, and observation state.
	single: Livt.Collections.Queue<byte, 1>
	large: Livt.Collections.Queue<byte, 64>
	integers: Livt.Collections.Queue<int, 3>
	flags: Livt.Collections.Queue<bool, 1>

	/**
	 * Allocates independent queues so the tests do not share content.
	 */
	new()
	{
		single = new Livt.Collections.Queue<byte, 1>()
		large = new Livt.Collections.Queue<byte, 64>()
		integers = new Livt.Collections.Queue<int, 3>()
		flags = new Livt.Collections.Queue<bool, 1>()
	}

	/**
	 * Capacity one wraps on every transfer and rejects both empty and full access.
	 */
	@Test
	fn TestCapacityOne()
	{
		single.Clear()
		var value: byte

		for (var index = 0; index < 4; index++) {
			assert single.TryEnqueue(index as byte) == true
			assert single.TryEnqueue(0xFF) == false
			assert single.GetCount() == 1
			assert single.GetSpace() == 0
			assert single.TryDequeue(value) == true
			assert value == index as byte
			assert single.TryDequeue(value) == false
			assert value == 0x00
		}
	}

	/**
	 * Fills all 64 cells and checks ordered draining and full rejection.
	 */
	@Test
	fn TestCapacity64()
	{
		large.Clear()

		for (var index = 0; index < 64; index++) {
			assert large.TryEnqueue(index as byte) == true
		}

		assert large.GetCount() == 64
		assert large.GetSpace() == 0
		assert large.TryEnqueue(0xFF) == false
		var value: byte

		for (var index = 0; index < 64; index++) {
			assert large.TryDequeue(value) == true
			assert value == index as byte
		}

		assert large.GetCount() == 0
		assert large.GetSpace() == 64
	}

	/**
	 * Checks the payload types and clear case.
	 */
	@Test
	fn TestPayloadTypesAndClear()
	{
		integers.Clear()
		assert integers.TryEnqueue(-123) == true
		var number: int
		assert integers.TryDequeue(number) == true
		assert number == -123
		assert integers.TryEnqueue(456) == true
		integers.Clear()
		assert integers.TryDequeue(number) == false
		assert number == 0
		assert flags.TryEnqueue(true) == true
		var flag: bool
		assert flags.TryDequeue(flag) == true
		assert flag == true
		assert flags.TryDequeue(flag) == false
		assert flag == false
	}
}
