namespace Livt.Collections.Tests

using Livt.Collections

/**
 * Verifies the same scheduled contract through generic interface references.
 */
@Test
component QueueInterfaceTest
{
	// Shared fixture instances, signals, and observation state.
	bytes: IQueue<byte>
	numbers: IQueue<int>

	/**
	 * Binds an inherited byte specialization and a generic integer queue.
	 */
	new()
	{
		bytes = new Queue8()
		numbers = new Livt.Collections.Queue<int, 3>()
	}

	/**
	 * Checks the named byte queue case.
	 */
	@Test
	fn TestNamedByteQueue()
	{
		bytes.Clear()
		assert bytes.GetSpace() == 8
		assert bytes.TryEnqueue(0x00) == true
		assert bytes.GetCount() == 1
		var value: byte = 0xFF
		assert bytes.TryDequeue(value) == true
		assert value == 0x00
		assert bytes.TryDequeue(value) == false
		assert value == 0x00
	}

	/**
	 * Checks the generic integer queue case.
	 */
	@Test
	fn TestGenericIntegerQueue()
	{
		numbers.Clear()
		assert numbers.TryEnqueue(-123) == true
		assert numbers.TryEnqueue(0) == true
		assert numbers.TryEnqueue(456) == true
		assert numbers.TryEnqueue(999) == false
		assert numbers.GetCount() == 3
		assert numbers.GetSpace() == 0
		var value: int
		assert numbers.TryDequeue(value) == true
		assert value == -123
		assert numbers.TryDequeue(value) == true
		assert value == 0
		assert numbers.TryDequeue(value) == true
		assert value == 456
		assert numbers.TryDequeue(value) == false
		assert value == 0
	}
}
