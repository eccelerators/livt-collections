namespace Livt.Collections.Circular

/**
 * Synthesizable overwrite-on-full circular buffer for up to 8 bytes.
 */
component CircularBuffer8 : ICircularBuffer
{
	// Maximum number of stored values.
	public const CAPACITY: int = 8

	memory: byte[8]

	head: int

	tail: int

	size: int

	/**
	 * Appends a value, overwriting the oldest value when full.
	 */
	override fn Write(value: byte)
	{
		if (this.size == CAPACITY) {
			this.head++

			if (this.head == CAPACITY) {
				this.head = 0
			}
		}

		if (this.size < CAPACITY) {
			this.size++
		}

		this.memory[this.tail] = value
		this.tail++

		if (this.tail == CAPACITY) {
			this.tail = 0
		}
	}

	/**
	 * Removes and returns the oldest value, or 0x00 when empty.
	 */
	override fn Read() byte
	{
		if (this.size > 0) {
			var element = this.memory[this.head]
			this.head++

			if (this.head == CAPACITY) {
				this.head = 0
			}

			this.size--
			return element
		}

		return 0x00
	}

	/**
	 * Returns the next readable value without removing it, or 0x00 when empty.
	 */
	override fn Peek() byte
	{
		if (this.size > 0) {
			return this.memory[this.head]
		}

		return 0x00
	}

	/**
	 * Returns true when the collection contains no values.
	 */
	override fn IsEmpty() bool
	{
		return this.size == 0
	}

	/**
	 * Returns true when the collection has reached its fixed capacity.
	 */
	override fn IsFull() bool
	{
		return this.size == CAPACITY
	}

	/**
	 * Returns the current logical number of values.
	 */
	override fn GetSize() int
	{
		return this.size
	}

	/**
	 * Resets the logical buffer state without erasing storage.
	 */
	override fn Clear()
	{
		this.head = 0
		this.tail = 0
		this.size = 0
	}
}
