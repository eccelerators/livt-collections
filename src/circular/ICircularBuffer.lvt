namespace Livt.Collections.Circular

/**
 * Contract for a fixed-capacity, byte-oriented circular buffer.
 *
 * Writes to a full buffer overwrite the oldest value. Empty reads return 0x00.
 */
interface ICircularBuffer
{
	/**
	 * Appends a value, overwriting the oldest value when full.
	 */
	fn Write(value: byte)

	/**
	 * Removes and returns the oldest value, or 0x00 when empty.
	 */
	fn Read() byte

	/**
	 * Returns the oldest value without removing it, or 0x00 when empty.
	 */
	fn Peek() byte

	/**
	 * Returns true when the buffer contains no values.
	 */
	fn IsEmpty() bool

	/**
	 * Returns true when the buffer has reached its fixed capacity.
	 */
	fn IsFull() bool

	/**
	 * Returns the current number of buffered values.
	 */
	fn GetSize() int

	/**
	 * Resets the logical buffer state without erasing storage.
	 */
	fn Clear()
}
