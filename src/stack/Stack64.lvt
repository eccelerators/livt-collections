namespace Livt.Collections.Stack

/**
 * Synthesizable LIFO stack for up to 64 bytes.
 */
component Stack64 : IStack
{
	// Maximum number of stored values.
	public const CAPACITY: int = 64

	memory: byte[64]

	position: int

	/**
	 * Appends a value to the top when capacity is available.
	 */
	override fn Push(value: byte)
	{
		if (this.position < CAPACITY) {
			this.memory[this.position] = value
			this.position++
		}
	}

	/**
	 * Removes and returns the newest value, or 0x00 when empty.
	 */
	override fn Pop() byte
	{
		if (this.position > 0) {
			this.position--
			return this.memory[this.position]
		}

		return 0x00
	}

	/**
	 * Returns the next readable value without removing it, or 0x00 when empty.
	 */
	override fn Peek() byte
	{
		if (this.position > 0) {
			var topIndex = this.position - 1
			return this.memory[topIndex]
		}

		return 0x00
	}

	/**
	 * Returns true when the collection contains no values.
	 */
	override fn IsEmpty() bool
	{
		return this.position == 0
	}

	/**
	 * Returns true when the collection has reached its fixed capacity.
	 */
	override fn IsFull() bool
	{
		return this.position == CAPACITY
	}

	/**
	 * Returns the current logical number of values.
	 */
	override fn GetSize() int
	{
		return this.position
	}

	/**
	 * Resets the logical stack state without erasing storage.
	 */
	override fn Clear()
	{
		this.position = 0
	}
}
