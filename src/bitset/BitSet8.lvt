namespace Livt.Collections.BitSet

/**
 * Synthesizable set of eight independently addressable boolean flags.
 *
 * Independent fields avoid the current stale staging behavior of indexed
 * writes to a shared logic vector.
 */
component BitSet8 : IBitSet
{
	// Number of addressable flags.
	public const CAPACITY: int = 8

	// Independent flag state avoids cross-function indexed-write staging.
	bit0: bool
	bit1: bool
	bit2: bool
	bit3: bool
	bit4: bool
	bit5: bool
	bit6: bool
	bit7: bool

	/**
	 * Sets one flag; invalid indices are ignored.
	 */
	override fn Set(index: int)
	{
		if (index == 0) {
			bit0 = true
		}

		if (index == 1) {
			bit1 = true
		}

		if (index == 2) {
			bit2 = true
		}

		if (index == 3) {
			bit3 = true
		}

		if (index == 4) {
			bit4 = true
		}

		if (index == 5) {
			bit5 = true
		}

		if (index == 6) {
			bit6 = true
		}

		if (index == 7) {
			bit7 = true
		}
	}

	/**
	 * Clears one flag; invalid indices are ignored.
	 */
	override fn Clear(index: int)
	{
		if (index == 0) {
			bit0 = false
		}

		if (index == 1) {
			bit1 = false
		}

		if (index == 2) {
			bit2 = false
		}

		if (index == 3) {
			bit3 = false
		}

		if (index == 4) {
			bit4 = false
		}

		if (index == 5) {
			bit5 = false
		}

		if (index == 6) {
			bit6 = false
		}

		if (index == 7) {
			bit7 = false
		}
	}

	/**
	 * Inverts one flag; invalid indices are ignored.
	 */
	override fn Toggle(index: int)
	{
		if (index == 0) {
			bit0 = bit0 == false
		}

		if (index == 1) {
			bit1 = bit1 == false
		}

		if (index == 2) {
			bit2 = bit2 == false
		}

		if (index == 3) {
			bit3 = bit3 == false
		}

		if (index == 4) {
			bit4 = bit4 == false
		}

		if (index == 5) {
			bit5 = bit5 == false
		}

		if (index == 6) {
			bit6 = bit6 == false
		}

		if (index == 7) {
			bit7 = bit7 == false
		}
	}

	/**
	 * Returns one flag, or false when index is invalid.
	 */
	override fn IsSet(index: int) bool
	{
		if (index == 0) {
			return bit0 == true
		}

		if (index == 1) {
			return bit1 == true
		}

		if (index == 2) {
			return bit2 == true
		}

		if (index == 3) {
			return bit3 == true
		}

		if (index == 4) {
			return bit4 == true
		}

		if (index == 5) {
			return bit5 == true
		}

		if (index == 6) {
			return bit6 == true
		}

		if (index == 7) {
			return bit7 == true
		}

		return false
	}

	/**
	 * Clears every flag.
	 */
	override fn Reset()
	{
		bit0 = false
		bit1 = false
		bit2 = false
		bit3 = false
		bit4 = false
		bit5 = false
		bit6 = false
		bit7 = false
	}

	/**
	 * Returns true when at least one flag is set.
	 */
	override fn Any() bool
	{
		return bit0 || bit1 || bit2 || bit3 || bit4 || bit5 || bit6 || bit7
	}

	/**
	 * Returns true when no flags are set.
	 */
	override fn None() bool
	{
		if (bit0 || bit1 || bit2 || bit3) {
			return false
		}

		if (bit4 || bit5 || bit6 || bit7) {
			return false
		}

		return true
	}

	/**
	 * Returns the flags encoded as a non-negative integer bit mask.
	 */
	override fn GetValue() int
	{
		var result: int = 0

		if (bit0 == true) {
			result = result + 1
		}

		if (bit1 == true) {
			result = result + 2
		}

		if (bit2 == true) {
			result = result + 4
		}

		if (bit3 == true) {
			result = result + 8
		}

		if (bit4 == true) {
			result = result + 16
		}

		if (bit5 == true) {
			result = result + 32
		}

		if (bit6 == true) {
			result = result + 64
		}

		if (bit7 == true) {
			result = result + 128
		}

		return result
	}

	/**
	 * Returns the fixed number of addressable flags.
	 */
	override fn GetCapacity() int
	{
		return CAPACITY
	}
}
